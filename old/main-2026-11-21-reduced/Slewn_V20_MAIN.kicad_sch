			(justify left)
		)
		(uuid "c7778fe6-c161-4c66-a94c-0f2612933737")
	)
	(text "1  Keyed ribbon cable, red stripe to -12 V at both ends."
		(exclude_from_sim no)
		(at 157.48 113.03 0)
		(effects
			(font (size 1.8 1.8))
			(justify left)
		)
		(uuid "0d6d4c2d-e99e-424d-8990-b87e03f1bf11")
	)
	(text "    Q1 blocks a reversed cable."
		(exclude_from_sim no)
		(at 157.48 116.84 0)
		(effects
			(font (size 1.8 1.8))
			(justify left)
		)
		(uuid "77d3891c-ba14-4a4b-a221-a742d97f8d5b")
	)
	(text "2  Check that U1 is set to 5 V."
		(exclude_from_sim no)
		(at 157.48 120.65 0)
		(effects
			(font (size 1.8 1.8))
			(justify left)
		)
		(uuid "7e24e93d-2718-4dd8-b39d-859a8e3ff4ae")
	)
	(text "3  Power up WITHOUT the Radxa: TP6 to TP7 reads 4.9-5.2 V."
		(exclude_from_sim no)
		(at 157.48 124.46 0)
		(effects
			(font (size 1.8 1.8))
			(justify left)
		)
		(uuid "44af0674-1f9b-48cf-a798-472d31fdcb18")
	)
	(text "4  Only then fit the Radxa."
		(exclude_from_sim no)
		(at 157.48 128.27 0)
		(effects
			(font (size 1.8 1.8))
			(justify left)
		)
		(uuid "3b5d8b6a-5b6d-4c8f-afb4-d8a6fdd4e87e")
	)
	(text "5  Other modules in the rack whine? Add a ferrite bead"
