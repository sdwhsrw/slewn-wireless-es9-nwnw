			(justify left)
		)
		(uuid "139c0b95-11dd-4d24-8e71-f06a1273fa38")
	)
	(text "正面装原厂 90° 公排针，插向面板。"
		(exclude_from_sim no)
		(at 157.48 97.79 0)
		(effects
